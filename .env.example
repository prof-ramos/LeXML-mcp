# LexML MCP — Environment Variables

# SRU endpoint
LEXML_SRU_URL=https://www.lexml.gov.br/busca/SRU

# URN resolution template
LEXML_URN_TEMPLATE=https://www.lexml.gov.br/urn/{urn}

# HTTP timeouts (seconds)
LEXML_TIMEOUT=15.0
LEXML_HTTP_CONNECT_TIMEOUT=5
LEXML_HTTP_READ_TIMEOUT=20

# Response limits
LEXML_HTTP_MAX_RESPONSE_BYTES=5242880
LEXML_HTTP_MAX_RETRIES=2
LEXML_MAX_REDIRECTS=5

# Query limits
LEXML_QUERY_MAX_LENGTH=4096
LEXML_MAXIMUM_RECORDS_LIMIT=50

# Cache
LEXML_CACHE_TTL=300
LEXML_CACHE_MAXSIZE=256

# Debug
LEXML_DEBUG_RAW_RESPONSES=false
LEXML_RAW_EXCERPT_MAX_CHARS=1024

# Logging
LEXML_LOG_LEVEL=INFO

# User agent
LEXML_USER_AGENT=lexml-mcp/0.2.0